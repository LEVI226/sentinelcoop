# ==========================================
# Back-end_filtrage (CIF Guard) - Variables d'environnement
# ==========================================

# ---- Serveur ----
APP_NAME=Back-end_filtrage
ENVIRONMENT=development
API_PREFIX=/api/v1
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ---- Base de données PostgreSQL ----
DATABASE_URL=postgresql+psycopg://cifguard:CifGuard%402026@127.0.0.1:5432/cifguard

# ---- Sécurité / Chiffrement ----
# Générer : python -m app.scripts.genkeys
JWT_SECRET=
JWT_EXPIRES_MINUTES=30
REFRESH_EXPIRES_DAYS=7
# Clé maîtresse AES-256-GCM (64 hex) pour chiffrer les dossiers clients sensibles
ENCRYPTION_MASTER_KEY=

# ---- Stockage (documents) ----
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage

# ---- Sécurité headers / CORS ----
CORS_ORIGINS=*
